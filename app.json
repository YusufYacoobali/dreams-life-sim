    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071D49",
        "foregroundImage": "./assets/generated/dreams-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yusufyacoobali.dreamslifesim",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "scheme": "dreams-life"
  }
}
