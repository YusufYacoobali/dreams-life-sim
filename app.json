      },
      "profileCommands": false,
      "profileCommandsBuild": {},
      "profileSourceRevision": {},
      "godModeTesting": false,
      "unlockAllTesting": false,
      "unlockAllTestingBuild": {},
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "666d482a-b9d3-411b-8483-decda542d53a"
      }
    }
