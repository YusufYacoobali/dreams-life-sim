{
  "expo": {
    "name": "Dreams Life Simulator",
    "slug": "dreams-life-sim",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/generated/dreams-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
