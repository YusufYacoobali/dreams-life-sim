{
  "expo": {
    "name": "Dreams Life Simulator",
    "slug": "dreams-life-sim",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/app_icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#061633",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yacoobali.lifesim",
      "buildNumber": "1"
    },
    "android": {
      "icon": "./assets/android-app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#071D49",
        "foregroundImage": "./assets/android-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.yacoobali.lifesim",
      "versionCode": 1
    },
    "plugins": [
      ["expo-splash-screen", { "backgroundColor": "#061633", "image": "./assets/cinematic-splash.png", "imageWidth": 1, "dark": { "backgroundColor": "#061633" } }],
      "expo-router",
      "expo-sqlite",
      "./plugins/withReleaseShrinking.cjs",
      "./plugins/withStoreReviewVisibility.cjs",
      ["./plugins/withLocalNotifications.cjs", { "color": "#1478F8", "icon": "./assets/notification-icon.png" }],
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundPlayback": false, "enableBackgroundRecording": false }]
    ],
    "scheme": "dreams-life"
  }
}
