# Optional overrides for the RevenueCat PUBLIC SDK keys bundled in app.json.
# Defaults already point to the Dreams Apple/Google apps. Never use secret API keys.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_OTHER_PUBLIC_SDK_KEY
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_OTHER_PUBLIC_SDK_KEY

# Paid features require verified purchases in all builds, including development.
# Legacy DREAMS_UNLOCK_ALL_TESTING flags are ignored.
