# RevenueCat PUBLIC app SDK keys. These are bundled into the app; never put secret API keys here.
# Leave unset until your Apple/Google products and entitlement mappings are configured.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=REPLACE_WITH_APPLE_PUBLIC_SDK_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=REPLACE_WITH_GOOGLE_PUBLIC_SDK_KEY
