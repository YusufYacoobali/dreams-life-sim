    {
      "id": "country-relocation-school-01",
      "priority": "P1",
      "status": "Source-path defect; command reproduction pending coordinator scope",
      "summary": "Work relocation to Italy can create a full-time job that next-month school auto-enrolment makes invalid",
      "trigger": "Age18, no secondary qualification, no explicit school withdrawal; accepted Italy cleaner/retail/barista/warehouse work offer",
      "evidence": [
        "src/game/rules.ts:36",
        "src/game/content/jobs.ts:9",
        "src/game/systems/relocation.ts:60",
        "src/game/systems/relocation.ts:184",
        "src/game/systems/education.ts:129",
        "src/game/model.ts:198"
      ],
      "effect": "educationMonth enrols secondary before monthly work, then validateWorld throws Invalid current employment",
      "recommendation": "Use a shared destination-school auto-enrol predicate to refuse work offers/moves that would leave the actor in destination compulsory school. Keep explicit withdrawal, qualification, current age rules and old offer history unchanged."
    }
  ],
